{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign tier_count = 0
  assign max_qty = 0
  assign max_discount = 0
  for i in (1..3)
    assign qty_key = 'tier_' | append: i | append: '_quantity'
    assign disc_key = 'tier_' | append: i | append: '_discount'
    assign q = section.settings[qty_key] | default: 0
    assign d = section.settings[disc_key] | default: 0
    if q > 0 and d > 0
      assign tier_count = tier_count | plus: 1
      if q > max_qty
        assign max_qty = q
      endif
      if d > max_discount
        assign max_discount = d
      endif
    endif
  endfor
  if max_qty < section.settings.min_items
    assign max_qty = section.settings.min_items
  endif

  assign bundle_collection = section.settings.collection
  assign hero_image = section.settings.image
  if hero_image == blank and bundle_collection != blank
    assign hero_image = bundle_collection.featured_image
  endif
  if hero_image == blank and bundle_collection != blank
    assign hero_image = bundle_collection.products.first.featured_media.preview_image
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="bundle-builder page-width section-{{ section.id }}-padding">
    <bundle-builder
      class="bundle-builder__grid"
      data-section-id="{{ section.id }}"
      data-min-items="{{ section.settings.min_items }}"
      data-subscription-discount="{{ section.settings.subscription_discount }}"
      data-currency="{{ cart.currency.iso_code }}"
      data-locale="{{ request.locale.iso_code }}"
      data-cart-url="{{ routes.cart_url }}"
      data-cart-add-url="{{ routes.cart_add_url }}"
      data-tiers='[
        {%- assign first_tier = true -%}
        {%- for i in (1..3) -%}
          {%- assign qty_key = 'tier_' | append: i | append: '_quantity' -%}
          {%- assign disc_key = 'tier_' | append: i | append: '_discount' -%}
          {%- if section.settings[qty_key] > 0 and section.settings[disc_key] > 0 -%}
            {%- unless first_tier -%},{%- endunless -%}
            {"quantity":{{ section.settings[qty_key] }},"discount":{{ section.settings[disc_key] }}}
            {%- assign first_tier = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]'
    >
      <div class="bundle-builder__media">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 1200
            | image_tag:
              class: 'bundle-builder__image',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 45vw, 100vw'
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'bundle-builder__image placeholder-svg' }}
        {%- endif -%}

        {%- if section.settings.badge_value != blank -%}
          <div class="bundle-builder__badge">
            {%- if section.settings.badge_text != blank -%}
              <span class="bundle-builder__badge-text">{{ section.settings.badge_text }}</span>
            {%- endif -%}
            <span class="bundle-builder__badge-value">{{ section.settings.badge_value }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="bundle-builder__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="bundle-builder__heading h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="bundle-builder__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if tier_count > 0 -%}
          <div class="bundle-builder__progress" role="group" aria-label="{{ 'sections.bundle_builder.progress' | t }}">
            <div class="bundle-builder__track">
              <div class="bundle-builder__fill" data-progress-fill></div>
              {%- for step in (1..max_qty) -%}
                {%- liquid
                  assign step_tier = nil
                  for i in (1..3)
                    assign qty_key = 'tier_' | append: i | append: '_quantity'
                    assign disc_key = 'tier_' | append: i | append: '_discount'
                    if section.settings[qty_key] == step and section.settings[disc_key] > 0
                      assign step_tier = section.settings[disc_key]
                    endif
                  endfor
                  assign step_left = step | times: 100.0 | divided_by: max_qty
                -%}
                <span
                  class="bundle-builder__step{% if step_tier %} bundle-builder__step--tier{% endif %}"
                  style="left: {{ step_left }}%;"
                  data-step="{{ step }}"
                >
                  {%- if step_tier -%}
                    <span class="bundle-builder__step-label">{{ 'sections.bundle_builder.off' | t: discount: step_tier }}</span>
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <ul class="bundle-builder__list" role="list">
          {%- if bundle_collection != blank and bundle_collection.products.size > 0 -%}
            {%- for product in bundle_collection.products limit: section.settings.products_to_show -%}
              {%- liquid
                assign selling_plan_id = ''
                if product.selling_plan_groups.size > 0
                  assign selling_plan_id = product.selling_plan_groups.first.selling_plans.first.id
                endif
                assign default_variant = product.selected_or_first_available_variant
              -%}
              <li
                class="bundle-builder__item"
                data-bundle-item
                data-selling-plan="{{ selling_plan_id }}"
                data-product-title="{{ product.title | escape }}"
              >
                <div class="bundle-builder__thumb">
                  {%- if product.featured_media != blank -%}
                    {{
                      product.featured_media
                      | image_url: width: 160
                      | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: product.featured_media.alt
                    }}
                  {%- endif -%}
                </div>

                <div class="bundle-builder__info">
                  <a href="{{ product.url }}" class="bundle-builder__title link">{{ product.title | escape }}</a>
                  <span class="bundle-builder__price caption-large" data-item-price>
                    {{- default_variant.price | money -}}
                  </span>
                </div>

                <fieldset class="bundle-builder__variants"{% if product.has_only_default_variant %} hidden{% endif %}>
                  <legend class="visually-hidden">{{ 'sections.bundle_builder.size' | t: product: product.title | escape }}</legend>
                  {%- for variant in product.variants limit: 4 -%}
                    <label class="bundle-builder__variant{% unless variant.available %} bundle-builder__variant--disabled{% endunless %}">
                      <input
                        type="radio"
                        name="bundle-{{ section.id }}-{{ product.id }}"
                        value="{{ variant.id }}"
                        data-price="{{ variant.price }}"
                        data-price-formatted="{{ variant.price | money | escape }}"
                        {% if variant.id == default_variant.id %}
                          checked
                        {% endif %}
                        {% unless variant.available %}
                          disabled
                        {% endunless %}
                      >
                      <span>{{ variant.title | escape }}</span>
                    </label>
                  {%- endfor -%}
                </fieldset>

                <div class="bundle-builder__qty">
                  <button
                    type="button"
                    class="bundle-builder__qty-btn"
                    data-qty-minus
                    disabled
                    aria-label="{{ 'sections.bundle_builder.decrease' | t: product: product.title | escape }}"
                  >
                    <span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
                  </button>
                  <input
                    class="bundle-builder__qty-input"
                    type="number"
                    min="0"
                    max="99"
                    value="0"
                    inputmode="numeric"
                    data-qty-input
                    aria-label="{{ 'sections.bundle_builder.quantity' | t: product: product.title | escape }}"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                  <button
                    type="button"
                    class="bundle-builder__qty-btn bundle-builder__qty-btn--plus"
                    data-qty-plus
                    aria-label="{{ 'sections.bundle_builder.increase' | t: product: product.title | escape }}"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                    <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                  </button>
                </div>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li class="bundle-builder__item bundle-builder__item--placeholder">
                <div class="bundle-builder__thumb">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="bundle-builder__info">
                  <span class="bundle-builder__title">{{ 'onboarding.product_title' | t }}</span>
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {%- if section.settings.enable_subscription -%}
          <div class="bundle-builder__subscription">
            {%- if section.settings.subscription_badge != blank -%}
              <span class="bundle-builder__subscription-badge">{{ section.settings.subscription_badge }}</span>
            {%- endif -%}
            <label class="bundle-builder__subscription-toggle">
              <input type="checkbox" data-subscribe>
              <span>{{ section.settings.subscription_label }}</span>
            </label>
          </div>
          {%- if section.settings.subscription_info != blank -%}
            <p class="bundle-builder__note caption-large">{{ section.settings.subscription_info }}</p>
          {%- endif -%}
          <p class="bundle-builder__note bundle-builder__note--warning caption-large" data-subscription-warning hidden>
            {{ 'sections.bundle_builder.subscription_unavailable' | t }}
          </p>
        {%- endif -%}

        <div class="bundle-builder__summary">
          <div class="bundle-builder__summary-row">
            <span><span data-count>0</span> {{ 'sections.bundle_builder.selected' | t }}</span>
            <span class="bundle-builder__discount-pill" data-discount-pill hidden></span>
          </div>
          <div class="bundle-builder__summary-row bundle-builder__summary-row--total">
            <span>{{ 'sections.bundle_builder.subtotal' | t }}</span>
            <span>
              <s class="bundle-builder__compare" data-compare hidden></s>
              <strong data-total>{{ 0 | money }}</strong>
            </span>
          </div>
          <p class="bundle-builder__note caption-large" data-min-message>
            {{ 'sections.bundle_builder.min_items' | t: count: section.settings.min_items }}
          </p>
          <button type="button" class="button button--full-width bundle-builder__submit" data-submit disabled>
            {{ section.settings.button_label }}
          </button>
          <p class="bundle-builder__note caption" data-discount-note>{{ 'sections.bundle_builder.discount_note' | t }}</p>
          <p class="bundle-builder__error caption-large" role="alert" data-error hidden></p>
          <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-announcer></div>
        </div>
      </div>
    </bundle-builder>
  </div>
</div>

<script type="application/json" id="BundleBuilderStrings-{{ section.id }}">
  {
    "off": {{ 'sections.bundle_builder.off' | t: discount: '__DISCOUNT__' | json }},
    "minItems": {{ 'sections.bundle_builder.min_items' | t: count: section.settings.min_items | json }},
    "adding": {{ 'sections.bundle_builder.adding' | t | json }},
    "added": {{ 'sections.bundle_builder.added' | t | json }},
    "error": {{ 'sections.bundle_builder.error' | t | json }}
  }
</script>

<style>
  .bundle-builder__grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .bundle-builder__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .bundle-builder__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--media-radius, 0);
  }

  .bundle-builder__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .bundle-builder__badge {
    position: absolute;
    top: 8%;
    left: 50%;
    width: clamp(10rem, 30%, 16rem);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 0.4rem 2rem rgba(0, 0, 0, 0.08);
  }

  .bundle-builder__badge-text {
    font-size: 1.2rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
  }

  .bundle-builder__badge-value {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 4vw, 4.4rem);
    line-height: 1.1;
  }

  .bundle-builder__heading {
    margin: 0 0 0.8rem;
  }

  .bundle-builder__subheading {
    margin-bottom: 2.4rem;
    color: rgba(var(--color-foreground), 0.8);
  }

  .bundle-builder__progress {
    padding: 0.6rem 1rem 3.2rem;
    margin-bottom: 1.6rem;
  }

  .bundle-builder__track {
    position: relative;
    height: 0.3rem;
    background: rgba(var(--color-foreground), 0.12);
    border-radius: 0.3rem;
  }

  .bundle-builder__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: rgb(var(--color-foreground));
    border-radius: 0.3rem;
    transition: width 0.35s ease;
  }

  .bundle-builder__step {
    position: absolute;
    top: 50%;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: rgb(var(--color-background));
    border: 0.15rem solid rgba(var(--color-foreground), 0.3);
    transform: translate(-50%, -50%);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .bundle-builder__step--tier {
    width: 1.4rem;
    height: 1.4rem;
    border-color: rgb(var(--color-foreground));
  }

  .bundle-builder__step.is-reached {
    background: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }

  .bundle-builder__step-label {
    position: absolute;
    top: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .bundle-builder__step.is-reached .bundle-builder__step-label {
    color: rgb(var(--color-foreground));
    font-weight: 600;
  }

  .bundle-builder__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .bundle-builder__item {
    display: grid;
    grid-template-columns: 5.6rem 1fr auto;
    grid-template-areas:
      'thumb info qty'
      'thumb variants variants';
    align-items: center;
    column-gap: 1.4rem;
    row-gap: 0.6rem;
    padding: 1rem 1.2rem;
    background: rgba(var(--color-foreground), 0.04);
    border-radius: 0.6rem;
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .bundle-builder__item.is-selected {
    background: rgba(var(--color-foreground), 0.08);
    box-shadow: inset 0.3rem 0 0 rgb(var(--color-foreground));
  }


  .bundle-builder__thumb {
    grid-area: thumb;
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 0.4rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }

  .bundle-builder__thumb img,
  .bundle-builder__thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bundle-builder__info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .bundle-builder__title {
    font-weight: 600;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    line-height: 1.3;
  }

  .bundle-builder__title:hover {
    text-decoration: underline;
  }

  .bundle-builder__price {
    color: rgba(var(--color-foreground), 0.7);
  }

  .bundle-builder__variants {
    grid-area: variants;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    border: 0;
    margin: 0;
    padding: 0;
  }

  .bundle-builder__variant {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .bundle-builder__variant input {
    accent-color: rgb(var(--color-foreground));
    margin: 0;
  }

  .bundle-builder__variant--disabled {
    opacity: 0.5;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .bundle-builder__qty {
    grid-area: qty;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bundle-builder__qty-btn {
    width: 3.2rem;
    height: 3.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.4rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .bundle-builder__qty-btn .svg-wrapper,
  .bundle-builder__qty-btn svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .bundle-builder__qty-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .bundle-builder__qty-input {
    width: 3.6rem;
    text-align: center;
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-size: 1.5rem;
    -moz-appearance: textfield;
  }

  .bundle-builder__qty-input::-webkit-outer-spin-button,
  .bundle-builder__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .bundle-builder__subscription {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin-top: 2rem;
    padding: 1.4rem 1.6rem;
    border-radius: 0.6rem;
    background: rgba(var(--color-foreground), 0.06);
  }

  .bundle-builder__subscription-badge {
    font-weight: 700;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
  }

  .bundle-builder__subscription-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    cursor: pointer;
  }

  .bundle-builder__subscription-toggle input {
    width: 1.8rem;
    height: 1.8rem;
    margin: 0;
    accent-color: rgb(var(--color-foreground));
  }

  .bundle-builder__note {
    margin: 0.8rem 0 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  .bundle-builder__summary {
    margin-top: 2.4rem;
    padding-top: 2rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }

  .bundle-builder__summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .bundle-builder__summary-row--total {
    font-size: 1.8rem;
  }

  .bundle-builder__compare {
    margin-right: 0.8rem;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 1.5rem;
  }

  .bundle-builder__discount-pill {
    padding: 0.3rem 1rem;
    border-radius: 2rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 1.3rem;
    font-weight: 600;
  }

  .bundle-builder__submit {
    margin-top: 1.6rem;
  }

  .bundle-builder__error {
    color: rgb(var(--color-foreground));
    margin: 1rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .bundle-builder__fill,
    .bundle-builder__item,
    .bundle-builder__step {
      transition: none;
    }
  }
</style>

<script>
  if (!customElements.get('bundle-builder')) {
    class BundleBuilder extends HTMLElement {
      connectedCallback() {
        this.minItems = parseInt(this.dataset.minItems, 10) || 1;
        this.subscriptionDiscount = parseFloat(this.dataset.subscriptionDiscount) || 0;
        try {
          this.tiers = JSON.parse(this.dataset.tiers || '[]').sort((a, b) => a.quantity - b.quantity);
        } catch (e) {
          this.tiers = [];
        }
        const stringsEl = document.getElementById(`BundleBuilderStrings-${this.dataset.sectionId}`);
        this.strings = stringsEl ? JSON.parse(stringsEl.textContent) : {};
        this.formatter = new Intl.NumberFormat(this.dataset.locale || undefined, {
          style: 'currency',
          currency: this.dataset.currency || 'USD',
        });

        this.items = Array.from(this.querySelectorAll('[data-bundle-item]'));
        this.subscribe = this.querySelector('[data-subscribe]');
        this.submitButton = this.querySelector('[data-submit]');
        this.steps = Array.from(this.querySelectorAll('[data-step]'));
        this.maxStep = this.steps.length;

        this.items.forEach((item) => {
          const input = item.querySelector('[data-qty-input]');
          item.querySelector('[data-qty-plus]')?.addEventListener('click', () => this.setQty(item, this.getQty(item) + 1));
          item.querySelector('[data-qty-minus]')?.addEventListener('click', () => this.setQty(item, this.getQty(item) - 1));
          input?.addEventListener('change', () => this.setQty(item, parseInt(input.value, 10) || 0));
          item.querySelectorAll('input[type="radio"]').forEach((radio) => {
            radio.addEventListener('change', () => {
              const price = item.querySelector('[data-item-price]');
              if (price) price.textContent = radio.dataset.priceFormatted.replace(/&amp;/g, '&');
              this.update();
            });
          });
        });

        this.subscribe?.addEventListener('change', () => this.update());
        this.submitButton?.addEventListener('click', () => this.addToCart());
        this.update();
      }

      disconnectedCallback() {
        cancelAnimationFrame(this.announceFrame);
      }

      getQty(item) {
        return parseInt(item.querySelector('[data-qty-input]')?.value, 10) || 0;
      }

      setQty(item, qty) {
        const value = Math.max(0, Math.min(99, qty));
        const input = item.querySelector('[data-qty-input]');
        if (input) input.value = value;
        this.update();
      }

      selectedVariant(item) {
        return item.querySelector('input[type="radio"]:checked');
      }

      currentTier(count) {
        let tier = null;
        this.tiers.forEach((t) => {
          if (count >= t.quantity) tier = t;
        });
        return tier;
      }

      update() {
        let count = 0;
        let subtotal = 0;
        let missingPlan = false;
        const subscribing = this.subscribe?.checked;

        this.items.forEach((item) => {
          const qty = this.getQty(item);
          const variant = this.selectedVariant(item);
          item.classList.toggle('is-selected', qty > 0);
          const minus = item.querySelector('[data-qty-minus]');
          if (minus) minus.disabled = qty === 0;
          if (qty > 0 && variant) {
            count += qty;
            subtotal += (parseInt(variant.dataset.price, 10) || 0) * qty;
            if (subscribing && !item.dataset.sellingPlan) missingPlan = true;
          }
        });

        const tier = count >= this.minItems ? this.currentTier(count) : null;
        let percent = tier ? tier.discount : 0;
        let total = subtotal * (1 - percent / 100);
        if (subscribing && this.subscriptionDiscount > 0) {
          total = total * (1 - this.subscriptionDiscount / 100);
        }

        this.querySelector('[data-count]').textContent = count;
        this.querySelector('[data-total]').textContent = this.formatter.format(total / 100);

        const compare = this.querySelector('[data-compare]');
        compare.hidden = total >= subtotal || subtotal === 0;
        compare.textContent = this.formatter.format(subtotal / 100);

        const pill = this.querySelector('[data-discount-pill]');
        pill.hidden = !percent;
        if (percent) pill.textContent = (this.strings.off || '__DISCOUNT__%').replace('__DISCOUNT__', percent);

        const warning = this.querySelector('[data-subscription-warning]');
        if (warning) warning.hidden = !missingPlan;

        this.querySelector('[data-min-message]').hidden = count >= this.minItems;
        this.submitButton.disabled = count < this.minItems;

        const fill = this.querySelector('[data-progress-fill]');
        if (fill && this.maxStep) fill.style.width = `${Math.min(count, this.maxStep) / this.maxStep * 100}%`;
        this.steps.forEach((step) => step.classList.toggle('is-reached', count >= parseInt(step.dataset.step, 10)));
      }

      announce(text) {
        const announcer = this.querySelector('[data-announcer]');
        if (!announcer) return;
        cancelAnimationFrame(this.announceFrame);
        announcer.textContent = '';
        this.announceFrame = requestAnimationFrame(() => {
          announcer.textContent = text;
        });
      }

      async addToCart() {
        const subscribing = this.subscribe?.checked;
        const items = [];
        this.items.forEach((item) => {
          const qty = this.getQty(item);
          const variant = this.selectedVariant(item);
          if (qty > 0 && variant) {
            const line = { id: parseInt(variant.value, 10), quantity: qty };
            if (subscribing && item.dataset.sellingPlan) line.selling_plan = parseInt(item.dataset.sellingPlan, 10);
            items.push(line);
          }
        });
        if (!items.length) return;

        const error = this.querySelector('[data-error]');
        error.hidden = true;
        this.submitButton.disabled = true;
        this.setAttribute('aria-busy', 'true');
        this.announce(this.strings.adding);

        try {
          const response = await fetch(`${this.dataset.cartAddUrl}.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.description || data.message || this.strings.error);
          this.announce(this.strings.added);
          window.location.href = this.dataset.cartUrl;
        } catch (e) {
          error.textContent = e.message || this.strings.error;
          error.hidden = false;
          this.submitButton.disabled = false;
        } finally {
          this.removeAttribute('aria-busy');
        }
      }
    }

    customElements.define('bundle-builder', BundleBuilder);
  }
</script>

