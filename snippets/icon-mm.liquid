{%- doc -%}
  Small line icons for the mix and match builder.
  @param {string} icon - box | truck | kcal | protein | chevron | star | lock
{%- enddoc -%}
{%- case icon -%}
  {%- when 'box' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M10 2.5 3 6v8l7 3.5 7-3.5V6l-7-3.5Z"/><path d="M3 6l7 3.5L17 6M10 9.5v8"/></svg>
  {%- when 'truck' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 5h10v8H2zM12 8h3l3 3v2h-6z"/><circle cx="5.5" cy="14.5" r="1.5"/><circle cx="14.5" cy="14.5" r="1.5"/></svg>
  {%- when 'kcal' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.5" y="4.5" width="15" height="11" rx="2"/><path d="M6 8v4M6 10l2-2M6 10l2 2M10.5 8.5h2v3h-2"/></svg>
  {%- when 'protein' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 13c2-1 3-4 6-5s5 0 8-3M3 17c3-1 4-4 7-5s4 0 7-2"/></svg>
  {%- when 'chevron' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m12 5-5 5 5 5"/></svg>
  {%- when 'star' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="#f5d34f" stroke="currentColor" stroke-width="1.2"><path d="m10 2.5 2.3 4.8 5.2.7-3.8 3.6.9 5.2L10 14.3l-4.6 2.5.9-5.2L2.5 8l5.2-.7L10 2.5Z"/></svg>
  {%- when 'lock' -%}
    <svg class="mm-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="9" width="12" height="8.5" rx="1.5"/><path d="M6.5 9V6.5a3.5 3.5 0 0 1 7 0V9"/></svg>
{%- endcase -%}
