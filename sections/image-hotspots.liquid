{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #ImageHotspots-{{ section.id }} {
    --hotspot-dot: {{ section.settings.dot_color }};
    --hotspot-text: {{ section.settings.text_color }};
    --hotspot-card: {{ section.settings.card_color }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="{% unless section.settings.full_width %}page-width {% endunless %}section-{{ section.id }}-padding">
    <div class="image-hotspots__layout image-hotspots__layout--image-{{ section.settings.image_position }}">
    <image-hotspots id="ImageHotspots-{{ section.id }}" class="image-hotspots">
      <div class="image-hotspots__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'image-hotspots__image',
              sizes: '(min-width: 1200px) 1200px, 100vw',
              widths: '375, 550, 750, 1100, 1500, 1800, 2400',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-hotspots__image placeholder-svg' }}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign x = block.settings.position_x
            assign align = 'center'
            if x < 25
              assign align = 'start'
            elsif x > 75
              assign align = 'end'
            endif
            assign vertical = 'above'
            if block.settings.position_y < 30
              assign vertical = 'below'
            endif
          -%}
          <div
            class="hotspot hotspot--{{ align }} hotspot--{{ vertical }}"
            style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%;"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="hotspot__dot"
              aria-expanded="false"
              aria-controls="Hotspot-{{ block.id }}"
              aria-label="{{ 'accessibility.hotspot_toggle' | t: title: block.settings.title | escape }}"
            >
              <span class="hotspot__pulse" aria-hidden="true"></span>
            </button>
            <div class="hotspot__card" id="Hotspot-{{ block.id }}" role="tooltip">
              {%- if block.settings.link != blank -%}<a class="hotspot__link" href="{{ block.settings.link }}">{%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="hotspot__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <p class="hotspot__price">{{ block.settings.price }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </image-hotspots>

    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="image-hotspots__content image-hotspots__content--{{ section.settings.text_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="image-hotspots__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-hotspots__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</div>

<style>
  #ImageHotspots-{{ section.id }} ~ .image-hotspots__content { --hotspot-heading: {{ section.settings.heading_color }}; }
  .image-hotspots__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: center;
  }
  @media screen and (min-width: 990px) {
    .image-hotspots__layout { grid-template-columns: 1fr 1fr; gap: 6.4rem; }
    .image-hotspots__layout--image-right .image-hotspots { order: 2; }
  }
  .image-hotspots__content--left { text-align: left; }
  .image-hotspots__content--center { text-align: center; }
  .image-hotspots__content--right { text-align: right; }
  .image-hotspots__heading {
    margin: 0 0 2rem;
    color: var(--hotspot-heading);
    font-weight: 700;
    line-height: 1.3;
  }
  .image-hotspots__text { color: rgb(var(--color-foreground)); line-height: 1.7; }
  .image-hotspots__text p { margin: 0 0 1.2rem; }
  .image-hotspots__text p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 989px) {
    .image-hotspots__content--right { text-align: left; }
  }
  .image-hotspots__media { position: relative; line-height: 0; }
  .image-hotspots__image { display: block; width: 100%; height: auto; }

  .hotspot {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 1;
    line-height: 1.4;
  }
  .hotspot.is-open,
  .hotspot:focus-within { z-index: 3; }

  .hotspot__dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.6rem;
    height: 2.6rem;
    margin: 0;
    padding: 0;
    transform: translate(-50%, -50%);
    border: 0.3rem solid #fff;
    border-radius: 50%;
    background: var(--hotspot-dot);
    box-shadow: 0 0.2rem 0.8rem rgba(0, 51, 73, 0.3);
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .hotspot__dot::before {
    /* larger tap target for fingers */
    content: '';
    position: absolute;
    inset: -1.2rem;
    border-radius: 50%;
  }
  .hotspot__dot:focus-visible { outline: 0.2rem solid var(--hotspot-text); outline-offset: 0.3rem; }
  .hotspot__pulse {
    position: absolute;
    inset: -0.3rem;
    border-radius: 50%;
    border: 0.2rem solid var(--hotspot-dot);
    animation: hotspot-pulse 2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes hotspot-pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(2); opacity: 0; }
  }

  .hotspot__card {
    position: absolute;
    left: 0;
    width: max-content;
    max-width: 22rem;
    padding: 1.2rem 1.6rem;
    border-radius: 0.8rem;
    background: var(--hotspot-card);
    color: var(--hotspot-text);
    box-shadow: 0 0.8rem 2.4rem rgba(0, 51, 73, 0.18), 0 0.1rem 0.3rem rgba(0, 51, 73, 0.12);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    --shift-x: -50%;
    --gap: 2.2rem;
  }
  /* invisible bridge so the card stays open while the mouse moves onto it */
  .hotspot__card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: var(--gap);
  }
  /* small pointer arrow */
  .hotspot__card::after {
    content: '';
    position: absolute;
    left: var(--arrow-left, 50%);
    width: 1.2rem;
    height: 1.2rem;
    background: var(--hotspot-card);
    transform: translateX(-50%) rotate(45deg);
  }
  .hotspot--above .hotspot__card { bottom: var(--gap); transform: translate(var(--shift-x), 0.6rem); }
  .hotspot--above .hotspot__card::before { top: 100%; }
  .hotspot--above .hotspot__card::after { bottom: -0.6rem; }
  .hotspot--below .hotspot__card { top: var(--gap); transform: translate(var(--shift-x), -0.6rem); }
  .hotspot--below .hotspot__card::before { bottom: 100%; }
  .hotspot--below .hotspot__card::after { top: -0.6rem; }

  .hotspot--start .hotspot__card { --shift-x: -2.4rem; --arrow-left: 2.4rem; }
  .hotspot--end .hotspot__card { --shift-x: calc(-100% + 2.4rem); --arrow-left: calc(100% - 2.4rem); }

  .hotspot.is-open .hotspot__card,
  .hotspot:focus-within .hotspot__card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(var(--shift-x), 0);
  }
  .hotspot.is-open .hotspot__dot { transform: translate(-50%, -50%) scale(1.1); }
  @media (hover: hover) {
    .hotspot:hover { z-index: 3; }
    .hotspot:hover .hotspot__card {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate(var(--shift-x), 0);
    }
    .hotspot:hover .hotspot__dot { transform: translate(-50%, -50%) scale(1.1); }
  }

  .hotspot__link { display: block; color: inherit; text-decoration: none; }
  .hotspot__link:hover .hotspot__title { text-decoration: underline; text-underline-offset: 0.3rem; }
  .hotspot__title,
  .hotspot__price {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    letter-spacing: 0.02em;
    color: var(--hotspot-text);
  }
  .hotspot__title { font-weight: 600; }
  .hotspot__price { margin-top: 0.2rem; font-weight: 400; opacity: 0.85; }

  @media screen and (max-width: 749px) {
    .hotspot__dot { width: 2.2rem; height: 2.2rem; }
    .hotspot__card { max-width: 17rem; padding: 1rem 1.2rem; --gap: 1.8rem; }
    .hotspot__title, .hotspot__price { font-size: 1.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hotspot__pulse { animation: none; }
    .hotspot__card, .hotspot__dot { transition: none; }
  }
</style>

<script>
  if (!customElements.get('image-hotspots')) {
    customElements.define(
      'image-hotspots',
      class ImageHotspots extends HTMLElement {
        connectedCallback() {
          this.hotspots = Array.from(this.querySelectorAll('.hotspot'));
          this.hotspots.forEach((hotspot) => {
            const button = hotspot.querySelector('.hotspot__dot');
            button.addEventListener('click', (event) => {
              event.stopPropagation();
              const willOpen = !hotspot.classList.contains('is-open');
              this.closeAll();
              if (willOpen) this.open(hotspot);
            });
          });
          this.onDocumentClick = (event) => {
            if (!this.contains(event.target) || !event.target.closest('.hotspot')) this.closeAll();
          };
          this.onKeyup = (event) => {
            if (event.key === 'Escape') this.closeAll();
          };
          document.addEventListener('click', this.onDocumentClick);
          document.addEventListener('keyup', this.onKeyup);
        }

        disconnectedCallback() {
          document.removeEventListener('click', this.onDocumentClick);
          document.removeEventListener('keyup', this.onKeyup);
        }

        open(hotspot) {
          hotspot.classList.add('is-open');
          hotspot.querySelector('.hotspot__dot').setAttribute('aria-expanded', 'true');
        }

        closeAll() {
          this.hotspots.forEach((hotspot) => {
            hotspot.classList.remove('is-open');
            hotspot.querySelector('.hotspot__dot').setAttribute('aria-expanded', 'false');
          });
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Image with hotspots",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#003349"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Hotspot style"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#4fb3e8"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Label background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Label text",
      "default": "#003349"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section colors",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price text",
          "default": "from $99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "range",
          "id": "position_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with hotspots",
      "blocks": [
        { "type": "hotspot", "settings": { "position_x": 30, "position_y": 40 } },
        { "type": "hotspot", "settings": { "position_x": 65, "position_y": 60 } }
      ]
    }
  ]
}
{% endschema %}
